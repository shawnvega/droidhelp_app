#!/bin/sh
set -u

if REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    cd "$REPO_ROOT" || exit 1
else
    SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
    case "$SCRIPT_DIR" in
        */.git/hooks) cd "$SCRIPT_DIR/../.." || exit 1 ;;
        */.githooks)  cd "$SCRIPT_DIR/.." || exit 1 ;;
    esac
fi

echo "Running pre-commit checks..."

echo "Step 1/2: Running Android Lint (./gradlew lintDebug)..."
./gradlew lintDebug
LINT_EXIT=$?
if [ "$LINT_EXIT" -ne 0 ]; then
    echo "Pre-commit hook failed: './gradlew lintDebug' exited with status $LINT_EXIT. Commit aborted." >&2
    exit "$LINT_EXIT"
fi

echo "Step 2/2: Running unit tests (./gradlew test)..."
./gradlew test
TEST_EXIT=$?
if [ "$TEST_EXIT" -ne 0 ]; then
    echo "Pre-commit hook failed: './gradlew test' exited with status $TEST_EXIT. Commit aborted." >&2
    exit "$TEST_EXIT"
fi

echo "All pre-commit checks passed!"
exit 0
